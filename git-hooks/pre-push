#!/bin/bash
# Pre-push hook Gradle cross-platform
DIR="$(git rev-parse --show-toplevel)"

# Detecta se estÃ¡ no Windows (Git Bash, WSL, Msys)
OS="$(uname -s)"
case "${OS}" in
    MSYS*|MINGW*|CYGWIN*)
        # Windows: chama PowerShell
        powershell.exe -ExecutionPolicy Bypass -File "$DIR/git-hooks/pre-push.ps1"
        ;;
    *)
        # Linux/macOS: Gradle direto
        "$DIR/gradlew" clean build -x test
        ;;
esac

exit $?
