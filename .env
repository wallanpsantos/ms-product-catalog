# =============================================================
# .env is listed in .gitignore and .dockerignore so secrets
# are NEVER committed to version control or baked into images.
# =============================================================

# MongoDB root credentials
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=change-me-in-production

# Database name
MONGO_DB_NAME=db-product-catalog

# Mongo Express web UI credentials
MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASSWORD=change-me-in-production
